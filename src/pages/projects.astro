---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.vue';
---

<Layout title="Projects | Sakha Wibisono" description="Project portfolio of Sakha Wibisono with case studies.">
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 space-y-6">
		<div>
			<h1 class="text-3xl font-extrabold text-white">Projects</h1>
			<p class="text-sm text-slate-400 mt-1">Filter by category. Click a card to open its case study.</p>
		</div>
		<ProjectGrid client:load />
	</main>
</Layout>
