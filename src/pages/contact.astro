---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.vue';
---

<Layout title="Contact | Sakha Wibisono" description="Have a role or project in mind? Or just a question about something I've built? Send a message and I will get back to you.">
	<main id="content" class="shell page">
		<header class="page-heading">
			<p class="eyebrow">My inbox is open</p>
			<h1>Let's talk.</h1>
			<p>Have a role in mind, a project that needs someone, or a question about something in my portfolio? I read everything that comes in. Send a message and I will get back to you.</p>
		</header>
		<ContactForm client:load />
	</main>
</Layout>
