import SkillsView from '../components/SkillsView.vue';
---

<Layout title="Skills | Sakha Wibisono" description="Technical stack and skills inventory of Sakha Wibisono.">
	<main id="content" class="shell page">
		<header class="page-heading">
			<p class="eyebrow">My toolkit</p>
