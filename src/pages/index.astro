---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sakha Wibisono | Informatics Fresh Graduate & Software Engineer Portfolio" description="Personal technical portfolio of Sakha Wibisono — Informatics graduate and software developer.">
	<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 space-y-10">
		<!-- Hero -->
		<section class="glass rounded-2xl p-8 sm:p-12">
			<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
				<div>
					<span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Informatics Graduate & Software Engineer</span>
					<h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-2 leading-tight">
						Sakha <span class="text-indigo-400">Wibisono</span>
					</h1>
					<p class="text-slate-300 text-base sm:text-lg leading-relaxed mt-4 max-w-2xl">
						Fresh graduate in Informatics from Telkom University with hands-on experience in software
						development through internships and organizational activities. Proficient in Frontend
						Development, JavaScript, ReactJS, API Integration, and modern web development technologies.
					</p>
					<div class="flex flex-wrap gap-3 mt-6">
						<a href="/projects" class="px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-500 transition">View Projects</a>
						<a href="/contact" class="px-5 py-2.5 rounded-lg glass text-slate-100 border border-white/10 hover:border-indigo-500/50 transition">Contact Me</a>
					</div>
				</div>
				<div class="hidden md:block text-right">
					<div class="glass rounded-xl p-6 max-w-xs">
						<div class="grid grid-cols-2 gap-4 text-center">
							<div>
								<p class="text-3xl font-extrabold text-white">3+</p>
								<p class="text-xs text-slate-400">Internships</p>
							</div>
							<div>
								<p class="text-3xl font-extrabold text-white">5</p>
								<p class="text-xs text-slate-400">Projects</p>
							</div>
							<div>
								<p class="text-3xl font-extrabold text-white">5</p>
								<p class="text-xs text-slate-400">Certificates</p>
							</div>
							<div>
								<p class="text-3xl font-extrabold text-white">24</p>
								<p class="text-xs text-slate-400">Technologies</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Featured Projects -->
		<section>
			<div class="flex justify-between items-center mb-6">
				<h2 class="text-2xl font-bold text-white">Featured Projects</h2>
				<a href="/projects" class="text-sm text-indigo-400 hover:text-indigo-300">View all →</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="featured-projects">
				<div class="glass rounded-2xl p-6 animate-pulse">
					<div class="h-4 bg-white/10 rounded w-3/4 mb-4"></div>
					<div class="h-4 bg-white/10 rounded w-1/2 mb-2"></div>
					<div class="h-3 bg-white/10 rounded w-full"></div>
				</div>
				<div class="glass rounded-2xl p-6 animate-pulse">
					<div class="h-4 bg-white/10 rounded w-3/4 mb-4"></div>
					<div class="h-4 bg-white/10 rounded w-1/2 mb-2"></div>
					<div class="h-3 bg-white/10 rounded w-full"></div>
				</div>
				<div class="glass rounded-2xl p-6 animate-pulse">
					<div class="h-4 bg-white/10 rounded w-3/4 mb-4"></div>
					<div class="h-4 bg-white/10 rounded w-1/2 mb-2"></div>
					<div class="h-3 bg-white/10 rounded w-full"></div>
				</div>
			</div>
		</section>

		<!-- Quick Links -->
		<section class="grid grid-cols-2 md:grid-cols-4 gap-4">
			<a href="/experience" class="glass rounded-xl p-6 hover:border-indigo-500/40 transition">
				<p class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Experience</p>
				<h3 class="font-bold text-white mt-1">3 Internships</h3>
				<p class="text-xs text-slate-400 mt-1">Peruri, Asah by Dicoding, PuTI Telkom</p>
			</a>
			<a href="/skills" class="glass rounded-xl p-6 hover:border-indigo-500/40 transition">
				<p class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Skills</p>
				<h3 class="font-bold text-white mt-1">24 Technologies</h3>
				<p class="text-xs text-slate-400 mt-1">Frontend, Backend, Data, Tools</p>
			</a>
			<a href="/education" class="glass rounded-xl p-6 hover:border-indigo-500/40 transition">
				<p class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Education</p>
				<h3 class="font-bold text-white mt-1">2 Degrees</h3>
				<p class="text-xs text-slate-400 mt-1">Bachelor + Diploma from Telkom University</p>
			</a>
			<a href="/certificates" class="glass rounded-xl p-6 hover:border-indigo-500/40 transition">
				<p class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Certificates</p>
				<h3 class="font-bold text-white mt-1">5 Certifications</h3>
				<p class="text-xs text-slate-400 mt-1">Dicoding & Coursera</p>
			</a>
		</section>

		<!-- CTA -->
		<section class="glass rounded-2xl p-8 text-center border border-indigo-500/30">
			<h2 class="text-2xl font-bold text-white">Ready to Collaborate?</h2>
			<p class="text-slate-300 mt-2 max-w-xl mx-auto">
				I'm open to opportunities — full-time roles, internships, or freelance projects.
				Let's build something great together.
			</p>
			<a href="/contact" class="mt-6 inline-block px-6 py-3 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-500 transition">Get In Touch →</a>
		</section>
	</main>

	<script>
		// Fetch featured projects from API and render
		async function loadFeatured() {
			try {
				const res = await fetch('http://localhost:8000/api/projects?featured=true&per_page=3');
				const json = await res.json();
				const projects = json.data ?? [];
				const container = document.getElementById('featured-projects');
				if (!projects.length || !container) return;

				container.innerHTML = projects.map(p => `
					<a href="/projects/${p.slug}" class="glass rounded-2xl p-6 flex flex-col justify-between hover:border-indigo-500/40 transition">
						<div class="space-y-3">
							<div class="flex justify-between items-start">
								<span class="text-xs px-2 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">${p.category}</span>
								<span class="text-xs text-slate-500">${p.year}</span>
							</div>
							<h3 class="font-bold text-white">${p.title}</h3>
							<p class="text-xs text-slate-400 leading-relaxed">${p.short_description ?? ''}</p>
						</div>
						<div class="pt-4 mt-4 border-t border-white/10">
							<div class="flex flex-wrap gap-1">
								${(p.technologies ?? []).map(t => `<span class="text-xs px-2 py-0.5 rounded-full bg-white/5 text-slate-300 border border-white/10">${t.name}</span>`).join('')}
							</div>
						</div>
					</a>
				`).join('');
			} catch (e) {
				console.warn('Failed to load featured projects', e);
			}
		}
		loadFeatured();
	</script>
</Layout>