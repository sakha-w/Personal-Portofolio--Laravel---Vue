---
import Layout from '../layouts/Layout.astro';
import ExperienceList from '../components/ExperienceList.vue';
---

<Layout title="Experience | Sakha Wibisono" description="Professional experience timeline of Sakha Wibisono.">
	<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10 space-y-8">
		<div class="border-b border-[#686A73]/15 pb-6">
			<span class="technical-label uppercase text-[#7f5be8] tracking-wider block font-semibold">// CAREER_TRACK</span>
			<h1 class="section-heading mt-1">Work Experience</h1>
			<p class="small-text mt-1 max-w-xl">
				Hands-on software development roles in enterprise and educational organizations, rendered dynamically from the Laravel API.
			</p>
		</div>
		<ExperienceList client:load />
	</main>
</Layout>
