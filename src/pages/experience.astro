---
import Layout from '../layouts/Layout.astro';
import ExperienceList from '../components/ExperienceList.vue';
---

<Layout title="Experience | Sakha Wibisono" description="Professional experience timeline of Sakha Wibisono.">
	<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 space-y-6">
		<div>
			<h1 class="text-3xl font-extrabold text-white">Experience</h1>
			<p class="text-sm text-slate-400 mt-1">Internships and professional journey, served live from the Laravel API.</p>
		</div>
		<ExperienceList client:load />
	</main>
</Layout>
