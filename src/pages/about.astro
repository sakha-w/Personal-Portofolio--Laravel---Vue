---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Sakha Wibisono" description="Profile, career journey, and technical interests of Sakha Wibisono.">
	<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 space-y-8">
		<section class="glass rounded-2xl p-8">
			<span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Profile</span>
			<h1 class="text-3xl font-extrabold text-white mt-2">Sakha Wibisono</h1>
			<p class="text-slate-400 text-sm mt-1">Informatics Fresh Graduate & Software Engineer — Bandung, Indonesia</p>
			<p class="text-slate-300 text-sm sm:text-base leading-relaxed mt-4">
				Fresh graduate in Informatics from Telkom University with hands-on experience in software
				development through internships and organizational activities. Proficient in Frontend
				Development, JavaScript, ReactJS, API Integration, and modern web development technologies.
				Experienced in developing responsive and user-friendly applications, collaborating with teams,
				and adapting to new technologies and development environments. Continuously expanding
				knowledge and skills in Data Science.
			</p>
			<div class="flex flex-wrap gap-3 mt-6 text-sm">
				<a href="mailto:sakhawibisono77@gmail.com" class="px-4 py-2 rounded-lg bg-indigo-600 text-white font-medium">Email Me</a>
				<a href="https://linkedin.com/in/sakha-wibisono" target="_blank" class="px-4 py-2 rounded-lg glass text-slate-200">LinkedIn ↗</a>
				<a href="https://github.com/sakha-wibisono" target="_blank" class="px-4 py-2 rounded-lg glass text-slate-200">GitHub ↗</a>
			</div>
		</section>

		<section class="glass rounded-2xl p-8">
			<span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Career Journey</span>
			<div class="mt-4 space-y-4 text-sm">
				<div class="border-l-2 border-indigo-500 pl-4">
					<p class="font-bold text-white">Bachelor of Informatics — Telkom University</p>
					<p class="text-slate-400">2024 – 2026 · GPA 3.50/4.00 · Generative AI thesis</p>
				</div>
				<div class="border-l-2 border-emerald-500 pl-4">
					<p class="font-bold text-white">Diploma in Software Application Engineering — Telkom University</p>
					<p class="text-slate-400">2021 – 2024 · GPA 3.67/4.00 · MedRecordX thesis</p>
				</div>
				<div class="border-l-2 border-amber-500 pl-4">
					<p class="font-bold text-white">Programmer Internship — Perum Peruri</p>
					<p class="text-slate-400">2026 · SSO frontend with Astro + Vue.js, OAuth 2.0 / OIDC</p>
				</div>
				<div class="border-l-2 border-sky-500 pl-4">
					<p class="font-bold text-white">Programmer Apprenticeship — Asah by Dicoding</p>
					<p class="text-slate-400">2025 – 2026 · Predictive lead scoring with React + Supabase</p>
				</div>
				<div class="border-l-2 border-violet-500 pl-4">
					<p class="font-bold text-white">Frontend Programmer Intern — Direktorat PuTI Telkom University</p>
					<p class="text-slate-400">2024 · T-Feeder academic system with AngularJS</p>
				</div>
			</div>
		</section>

		<section class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<div class="glass rounded-2xl p-8">
				<span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Technical Interests</span>
				<ul class="mt-3 space-y-2 text-sm text-slate-300 list-disc list-inside">
					<li>Frontend engineering & design-to-code</li>
					<li>Authentication systems (OAuth 2.0 / OIDC)</li>
					<li>Applied machine learning & generative AI</li>
					<li>Process mining & data science</li>
				</ul>
			</div>
			<div class="glass rounded-2xl p-8">
				<span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Personal Approach</span>
				<p class="mt-3 text-sm text-slate-300 leading-relaxed">
					Every technical feature must have a reason to exist. I focus on readable code,
					API-first integration, and user-friendly interfaces — collaborating in Agile teams
					and documenting decisions along the way.
				</p>
			</div>
		</section>
	</main>
</Layout>
