---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Sakha Wibisono" description="Profile, career journey, and technical interests of Sakha Wibisono.">
	<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10 space-y-10">
		<!-- Profile Card -->
		<section class="glass-card rounded-3xl p-6 sm:p-10 relative overflow-hidden">
			<div class="space-y-4">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-lavender/25 border border-lavender text-ink font-mono text-xs leading-normal tracking-normal">
					<span>BIOGRAPHY // PROFILE</span>
				</div>
				<h1 class="text-4xl sm:text-5xl lg:text-6xl leading-[1.05] font-extrabold tracking-normal text-ink">Sakha Wibisono</h1>
				<p class="font-mono text-xs leading-normal tracking-normal text-muted">
					Informatics Graduate & Software Engineer · Bandung, Indonesia
				</p>
				<p class="text-base leading-relaxed text-muted max-w-3xl">
					Informatics graduate from <strong class="text-ink font-semibold">Telkom University</strong> with demonstrated hands-on experience across enterprise internships and engineering projects. Specialized in modern frontend architecture (Astro, Vue.js, React), backend API development (Laravel), and robust relational database modeling. Passionate about software craftsmanship, clean API design, and pragmatic machine learning applications.
				</p>
				<div class="flex flex-wrap items-center gap-3 pt-3">
					<a href="mailto:sakhawibisono77@gmail.com" class="px-5 py-2.5 rounded-full glass-button-primary text-xs sm:text-sm font-semibold">
						Email Me
					</a>
					<a href="https://linkedin.com/in/sakha-wibisono" target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 rounded-full glass-button-secondary text-xs sm:text-sm font-mono text-xs leading-normal tracking-normal flex items-center gap-1.5">
						<span>LinkedIn</span>
						<span class="text-xs">↗</span>
					</a>
					<a href="https://github.com/sakha-wibisono" target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 rounded-full glass-button-secondary text-xs sm:text-sm font-mono text-xs leading-normal tracking-normal flex items-center gap-1.5">
						<span>GitHub</span>
						<span class="text-xs">↗</span>
					</a>
				</div>
			</div>
		</section>

		<!-- Career Journey Timeline -->
		<section class="glass-card rounded-3xl p-6 sm:p-10 space-y-6">
			<div class="border-b border-[#686A73]/15 pb-4">
				<span class="font-mono text-xs leading-normal tracking-normal uppercase text-lavender-strong tracking-wider block font-semibold">// CHRONOLOGY</span>
				<h2 class="text-3xl sm:text-4xl leading-tight font-bold tracking-normal text-ink mt-1">Career Journey & Education</h2>
			</div>

			<div class="relative border-l border-[#686A73]/20 pl-6 ml-3 sm:ml-4 space-y-8">
				<!-- Item 1 - Lavender -->
				<div class="relative group">
					<div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-lavender border-2 border-white shadow-xs"></div>
					<div class="glass-subtle rounded-2xl p-5 border border-white space-y-1.5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<h3 class="text-xl leading-snug font-semibold tracking-normal text-ink">Bachelor of Informatics — Telkom University</h3>
							<span class="font-mono text-xs leading-normal tracking-normal px-2.5 py-0.5 rounded-full bg-lavender/30 border border-lavender text-ink font-medium">2024 – 2026</span>
						</div>
						<p class="font-mono text-xs leading-normal tracking-normal text-muted">Bandung · GPA 3.50 / 4.00 · Focus: Generative AI Thesis</p>
						<p class="text-sm leading-relaxed text-muted pt-1">
							Specialized in process mining algorithms and LLM-assisted workflow discovery.
						</p>
					</div>
				</div>

				<!-- Item 2 - Peach -->
				<div class="relative group">
					<div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-peach border-2 border-white shadow-xs"></div>
					<div class="glass-subtle rounded-2xl p-5 border border-white space-y-1.5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<h3 class="text-xl leading-snug font-semibold tracking-normal text-ink">Programmer Internship — Perum Peruri</h3>
							<span class="font-mono text-xs leading-normal tracking-normal px-2.5 py-0.5 rounded-full bg-peach/40 border border-peach text-ink font-medium">2026</span>
						</div>
						<p class="font-mono text-xs leading-normal tracking-normal text-muted">Jakarta / Remote · Enterprise SSO Frontend</p>
						<p class="text-sm leading-relaxed text-muted pt-1">
							Architected Single Sign-On (SSO) client interface utilizing Astro and Vue.js with OAuth 2.0 / OpenID Connect specifications.
						</p>
					</div>
				</div>

				<!-- Item 3 - Blue -->
				<div class="relative group">
					<div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-blue border-2 border-white shadow-xs"></div>
					<div class="glass-subtle rounded-2xl p-5 border border-white space-y-1.5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<h3 class="text-xl leading-snug font-semibold tracking-normal text-ink">Programmer Apprenticeship — Asah by Dicoding</h3>
							<span class="font-mono text-xs leading-normal tracking-normal px-2.5 py-0.5 rounded-full bg-blue/40 border border-blue text-ink font-medium">2025 – 2026</span>
						</div>
						<p class="font-mono text-xs leading-normal tracking-normal text-muted">Bandung / Hybrid · Predictive Lead Scoring & React</p>
						<p class="text-sm leading-relaxed text-muted pt-1">
							Developed customer lead classification and predictive scoring models with React dashboards backed by Supabase.
						</p>
					</div>
				</div>

				<!-- Item 4 - Mint -->
				<div class="relative group">
					<div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-mint border-2 border-white shadow-xs"></div>
					<div class="glass-subtle rounded-2xl p-5 border border-white space-y-1.5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<h3 class="text-xl leading-snug font-semibold tracking-normal text-ink">Frontend Programmer Intern — Direktorat PuTI Telkom University</h3>
							<span class="font-mono text-xs leading-normal tracking-normal px-2.5 py-0.5 rounded-full bg-mint/40 border border-mint text-ink font-medium">2024</span>
						</div>
						<p class="font-mono text-xs leading-normal tracking-normal text-muted">Telkom University · T-Feeder Academic System</p>
						<p class="text-sm leading-relaxed text-muted pt-1">
							Maintained and modernized high-throughput academic modules using AngularJS and REST APIs for university staff.
						</p>
					</div>
				</div>

				<!-- Item 5 - Pink -->
				<div class="relative group">
					<div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-pink border-2 border-white shadow-xs"></div>
					<div class="glass-subtle rounded-2xl p-5 border border-white space-y-1.5">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<h3 class="text-xl leading-snug font-semibold tracking-normal text-ink">Diploma in Software Application Engineering — Telkom University</h3>
							<span class="font-mono text-xs leading-normal tracking-normal px-2.5 py-0.5 rounded-full bg-pink/40 border border-pink text-ink font-medium">2021 – 2024</span>
						</div>
						<p class="font-mono text-xs leading-normal tracking-normal text-muted">Bandung · GPA 3.67 / 4.00 · Focus: MedRecordX Thesis</p>
						<p class="text-sm leading-relaxed text-muted pt-1">
							Engineered full-stack electronic medical record application with modular healthcare workflows.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Technical Interests & Engineering Philosophy -->
		<section class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<div class="glass-card rounded-3xl p-6 sm:p-8 space-y-4">
				<span class="font-mono text-xs leading-normal tracking-normal uppercase text-lavender-strong tracking-wider block font-semibold">// CORE_FOCUS</span>
				<h3 class="text-xl leading-snug font-semibold tracking-normal text-ink">Technical Interests</h3>
				<ul class="space-y-2.5 text-sm leading-relaxed text-muted font-mono text-ink">
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-lavender"></span> Modern Component Architecture (Astro, Vue, React)
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-blue"></span> Enterprise Authentication (OAuth 2.0 / OIDC / Sanctum)
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-mint"></span> Scalable Backend REST Services & Clean Architecture
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-peach"></span> Applied Machine Learning & Process Discovery
					</li>
				</ul>
			</div>

			<div class="glass-card rounded-3xl p-6 sm:p-8 space-y-4">
				<span class="font-mono text-xs leading-normal tracking-normal uppercase text-lavender-strong tracking-wider block font-semibold">// PHILOSOPHY</span>
				<h3 class="text-xl leading-snug font-semibold tracking-normal text-ink">Engineering Approach</h3>
				<blockquote class="text-base leading-relaxed text-muted border-l-2 border-lavender pl-4 py-1 italic">
					"Every technical feature must have a reason to exist. I build software prioritizing maintainability, type safety, resilient data pipelines, and clear user experiences."
				</blockquote>
			</div>
		</section>
	</main>
</Layout>
