# Copy to .env.production for a first deployment; merge values on subsequent updates.
# Keep the existing Compose project name, APP_KEY, and database credentials when upgrading.
APP_NAME=Laravel
RELEASE_TAG=local
APP_KEY=
APP_URL=http://sakha-dev.indonesiacentral.cloudapp.azure.com
HTTP_PORT=80
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
SANCTUM_STATEFUL_DOMAINS=
# Use true after HTTPS is configured and APP_URL uses https://.
SESSION_SECURE_COOKIE=false
